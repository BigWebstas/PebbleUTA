{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://0.0.0.0:8080",
  "Proxy": {
    "StaticUrl": "https://apps.rideuta.com/tms/gtfs/Static",
    "TripUpdatesUrl": "https://apps.rideuta.com/tms/gtfs/TripUpdate",
    "VehiclePositionsUrl": "https://apps.rideuta.com/tms/gtfs/Vehicle",
