<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS hosting via the ASP.NET Core Module (in-process).
  `dotnet publish` rewrites this file for the chosen deployment:
    - framework-dependent  -> processPath="dotnet"  arguments=".\PebbleUtaProxy.dll"
    - self-contained       -> processPath=".\PebbleUtaProxy.exe" arguments=""
  Committed here mainly so environment variables and logging are visible/editable.
  Requires the "ASP.NET Core Hosting Bundle" installed on the IIS server.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet"
                  arguments=".\PebbleUtaProxy.dll"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
          <!-- Override any appsettings value, e.g.:
          <environmentVariable name="PROXY__WINDOWMINUTES" value="120" />
          -->
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
